{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DocGuardConfig",
  "type": "object",
  "required": ["project", "type", "docs", "mode"],
  "properties": {
    "schema_version": { "type": "string" },
    "project": { "type": "string", "minLength": 1 },
    "type": {
      "type": "string",
      "description": "技术栈类型。内置值：java-spring / java-gradle / vue-ts / uniapp / go / python / react-ts；自定义类型需同时声明 custom_detector。"
    },
    "custom_detector": {
      "type": "object",
      "description": "type 不在内置列表时使用（v5.2 新增）",
      "properties": {
        "source_files": {
          "type": "object",
          "properties": {
            "pattern": { "type": "string" },
            "route_regex": { "type": "string" }
          },
          "required": ["pattern"]
        },
        "doc_sync_check": {
          "type": "string",
          "enum": ["manual", "regex"],
          "description": "manual：不做自动diff，仅警告需人工核对；regex：使用 source_files.route_regex 做基础 diff"
        }
      },
      "required": ["source_files", "doc_sync_check"]
    },
    "mode": {
      "type": "string",
      "enum": ["standalone", "team"]
    },
    "team_name": { "type": "string" },
    "description": { "type": "string" },
    "team": {
      "type": "object",
      "description": "角色权限配置（v5.2 新增，mode=team 时生效）",
      "properties": {
        "my_role": {
          "type": "string",
          "description": "当前 MCP Server 实例的角色 ID，从此配置读取（非 MCP 协议层传递）"
        },
        "roles": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "allowed_tools"],
            "properties": {
              "id": { "type": "string" },
              "allowed_tools": {
                "type": "array",
                "items": { "type": "string" },
                "description": "允许调用的工具列表，\"*\" 表示全权限"
              },
              "denied_tools": {
                "type": "array",
                "items": { "type": "string" },
                "description": "明确禁止调用的工具（优先级高于 allowed_tools）"
              }
            }
          }
        }
      }
    },
    "skill": {
      "type": "object",
      "description": "Skill 触发词扩展（v5.2 新增）",
      "properties": {
        "extra_triggers": {
          "type": "array",
          "items": { "type": "string" },
          "description": "项目专属触发词，由 setup-skills.sh 合并到团队 skill-template.yaml"
        },
        "allow_doc_write": {
          "description": "v5.3：apply_doc_patch 写入权限档位。stub_only | full | false",
          "oneOf": [
            { "type": "string", "enum": ["stub_only", "full"] },
            { "type": "boolean", "enum": [false] }
          ]
        }
      }
    },
    "steering": {
      "type": "object",
      "description": "v5.9：Steering 注入配置（CLI 自动检测和文档注入）",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "false 则跳过所有 CLI 注入，默认 true"
        },
        "inject": {
          "type": "boolean",
          "description": "true 则对本项目所有文档类型执行注入，默认 false"
        },
        "clis": {
          "type": "array",
          "description": "指定要注入的 CLI id 列表，空数组表示自动检测全部内置 CLI",
          "items": {
            "type": "string"
          }
        },
        "doc_types": {
          "type": "array",
          "items": { "type": "string" },
          "description": "默认注入的文档类型列表，不填则对 docs 下所有类型执行"
        },
        "cli": {
          "description": "auto（自动检测全部内置 CLI）或指定 CLI id 数组",
          "oneOf": [
            { "type": "string", "enum": ["auto"] },
            {
              "type": "array",
              "items": {
                "type": "string",
                "enum": ["kiro", "cursor", "codebuddy", "claude", "trae", "cline", "windsurf"]
              }
            }
          ]
        },
        "custom_cli": {
          "type": "array",
          "description": "扩展不在内置列表中的 CLI 工具，始终生效（不受 cli 字段控制）",
          "items": {
            "type": "object",
            "required": ["id", "rules_file", "strategy"],
            "properties": {
              "id": {
                "type": "string",
                "description": "自定义标识符，不得与内置 CLI id 重名",
                "pattern": "^(?!kiro$|cursor$|codebuddy$|claude$|droid$|trae$|cline$|windsurf$)[a-zA-Z0-9_-]{1,64}$"
              },
              "rules_file": {
                "type": "string",
                "description": "规则文件路径（相对项目根目录），不得以 .. 开头",
                "pattern": "^(?!\\.\\.).*$"
              },
              "strategy": {
                "type": "string",
                "enum": ["append", "symlink", "inline"],
                "description": "写入策略：append（追加引用行）| symlink（软链接）| inline（内联副本）"
              },
              "detect": {
                "type": "object",
                "description": "可选：CLI 安装检测条件，全部满足才写入；不填则始终写入",
                "properties": {
                  "bin": {
                    "type": "string",
                    "description": "检测 $PATH 中是否存在该可执行文件"
                  },
                  "dir": {
                    "type": "string",
                    "description": "检测目录是否存在（支持 ~ 前缀）"
                  },
                  "env": {
                    "type": "string",
                    "description": "检测环境变量是否已设置（非空）"
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "controller": {
      "type": "object",
      "properties": {
        "pattern": { "type": "string" },
        "annotation_regex": { "type": "string" }
      },
      "required": ["pattern", "annotation_regex"]
    },
    "api_call": {
      "type": "object",
      "properties": {
        "pattern": { "type": "string" },
        "call_regex": { "type": "string" }
      },
      "required": ["pattern", "call_regex"]
    },
    "docs": {
      "type": "object",
      "required": ["changelog"],
      "properties": {
        "changelog": {
          "type": "object",
          "required": ["path", "pending_path"],
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^(?!/)",
              "description": "相对路径，不得以 / 开头（禁止绝对路径）"
            },
            "pending_path": { "type": "string" },
            "format": { "type": "string", "enum": ["keepachangelog", "timestamp"] },
            "auto_version": { "type": "boolean" },
            "triggers": { "type": "array", "items": { "type": "string" } }
          }
        },
        "api": {
          "type": "object",
          "required": ["path"],
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^(?!/)",
              "description": "相对路径，不得以 / 开头"
            },
            "triggers": { "type": "array", "items": { "type": "string" } },
            "path_extract_regex": { "type": "string" },
            "contract_path": { "type": "string" },
            "auto_write": {
              "oneOf": [
                { "type": "string", "enum": ["stub_only", "full"] },
                { "type": "boolean", "enum": [false] }
              ]
            },
            "auto_write_template": { "type": "string" },
            "note": { "type": "string" },
            "steering": {
              "$ref": "#/definitions/steeringDocConfig"
            }
          }
        },
        "database": {
          "type": "object",
          "required": ["path"],
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^(?!/)",
              "description": "相对路径，不得以 / 开头"
            },
            "triggers": { "type": "array", "items": { "type": "string" } },
            "entity_pattern": { "type": "string" },
            "migration_pattern": { "type": "string" },
            "auto_write_template": { "type": "string" },
            "steering": {
              "$ref": "#/definitions/steeringDocConfig"
            }
          }
        },
        "overview": {
          "type": "object",
          "required": ["path"],
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^(?!/)",
              "description": "相对路径，不得以 / 开头"
            },
            "triggers": { "type": "array", "items": { "type": "string" } },
            "auto_write_template": { "type": "string" },
            "steering": {
              "$ref": "#/definitions/steeringDocConfig"
            }
          }
        }
      },
      "additionalProperties": {
        "type": "object",
        "description": "v5.2：允许任意自定义文档类型（如 pages、specs、adr 等）；key 须符合 ^[a-zA-Z0-9_-]{1,64}$",
        "required": ["path"],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(?!/)",
            "description": "相对路径，不得以 / 开头"
          },
          "triggers": { "type": "array", "items": { "type": "string" } },
          "path_extract_regex": { "type": "string" },
          "description": { "type": "string" },
          "auto_write": {
            "oneOf": [
              { "type": "string", "enum": ["stub_only", "full"] },
              { "type": "boolean", "enum": [false] }
            ]
          },
          "auto_write_template": { "type": "string" },
          "steering": {
            "$ref": "#/definitions/steeringDocConfig"
          }
        },
        "additionalProperties": false
      }
    },
    "trigger_patterns": {
      "type": "object",
      "description": "v5.3 新增：trigger 名称 → 文件 glob 映射，供 check_custom_doc_sync 消费",
      "additionalProperties": { "type": "string" }
    },
    "coverage_baseline": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          { "type": "number", "minimum": 0, "maximum": 1 },
          { "type": "string", "enum": ["disabled"] }
        ]
      }
    }
  },
  "definitions": {
    "steeringDocConfig": {
      "type": "object",
      "description": "v5.9：单文档的 steering 注入配置",
      "properties": {
        "inject": {
          "type": "boolean",
          "description": "true 注入 / false 不注入（默认 false）"
        },
        "inclusion": {
          "type": "string",
          "enum": ["always", "fileMatch"],
          "description": "always（始终注入）/ fileMatch（匹配文件时注入，仅对 Kiro/Cursor wrapper 类有效）"
        },
        "globs": {
          "type": "array",
          "items": { "type": "string" },
          "description": "fileMatch 时生效的文件匹配规则"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "if": { "properties": { "type": { "const": "java-spring" } } },
  "then": { "required": ["controller"] },
  "else": {
    "if": {
      "properties": { "type": { "enum": ["vue-ts", "uniapp"] } }
    },
    "then": { "required": ["api_call"] }
  }
}
